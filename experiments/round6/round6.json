     "speakers": [],
     "has_duration": false
    },
    {
     "id": "1320-122612-0005",
     "lang": "en",
     "text": "Yet here are we within a short range of the Scoonons and not a sign of a trail have we crossed.",
     "err": 0.0476,
     "n_seg": 0,
     "speakers": [],
     "has_duration": false
    }
   ]
