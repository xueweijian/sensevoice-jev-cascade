   "records": [
    {
     "id": "BAC009S0002W0122",
     "lang": "zh",
     "text": "而对面楼市成交抑制作用最大的限购。",
     "err": 0.0667,
     "n_seg": 0,
     "speakers": [],
     "has_duration": false
    },
    {
     "id": "BAC009S0002W0130",
     "lang": "zh",
     "text": "财政金融政策紧随其候而来。",
     "err": 0.0833,
     "n_seg": 0,
     "speakers": [],
     "has_duration": false
    },
    {
     "id": "BAC009S0002W0132",
     "lang": "zh",
     "text": "放松了与自网需求密切相关的房贷政策。",
     "err": 0.0588,
     "n_seg": 0,
     "speakers": [],
     "has_duration": false
    },
    {
     "id": "BAC009S0002W0136",
     "lang": "zh",
     "text": "这个后来被称为930新政策的措施。",
